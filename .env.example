# ─────────────────────────────────────────────────────────────
# GlobeSpeak Academy — variables d'environnement
# Copiez ce fichier en `.env` (jamais commité) et complétez-le.
# Toutes les variables sont validées au démarrage par src/env.ts.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (sans slash final)
APP_URL="http://localhost:3000"

# ── Base de données ─────────────────────────────────────────
# Local : `npm run db:start` (PostgreSQL 17 embarqué, sans Docker — scripts/db.mjs)
# Production : chaîne de connexion Neon (pooled) avec ?sslmode=require
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54320/globespeak"

# ── Authentification (Better Auth) ──────────────────────────
# Secret de signature des cookies/jetons — 32 octets aléatoires minimum
BETTER_AUTH_SECRET=""
# Google OAuth (optionnel) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Chiffrement applicatif ─────────────────────────────────
# Clé AES-256-GCM (32 octets en base64) pour les liens Meet et secrets 2FA
ENCRYPTION_KEY=""

# ── Compte administrateur initial (utilisé par `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@globespeak.local"
SEED_ADMIN_NAME="Administrateur"
# 12 caractères minimum. Changez-le après la première connexion.
SEED_ADMIN_PASSWORD=""

# Destinataire(s) des notifications de nouvelles inscriptions (séparés par des virgules)
ADMIN_NOTIFICATION_EMAILS="admin@globespeak.local"

# ── Emails (Resend) ─────────────────────────────────────────
# Vide en local : les emails sont écrits dans .dev-mailbox/ et visibles sur /dev/mailbox
RESEND_API_KEY=""
EMAIL_FROM="GlobeSpeak Academy <no-reply@globespeak.example>"
# Ou envoi par SMTP, prioritaire sur Resend — ex. Gmail : compte Google → Sécurité → Validation en deux étapes
# → « Mots de passe des applications ». L'expéditeur sera l'adresse Gmail (SMTP_USER).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ── Tâches planifiées ──────────────────────────────────────
# Jeton partagé exigé par les routes /api/cron/* (QStash ou Vercel Cron)
CRON_SECRET=""

# ── Services de production (vides en développement : fallback local) ──
# Vidéo — Mux
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""
# Fichiers — Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Dossier du stockage local de développement (défaut : .dev-storage)
LOCAL_STORAGE_DIR=""
# Vercel Blob (magasin privé relié au projet : jeton ajouté automatiquement par Vercel)
BLOB_READ_WRITE_TOKEN=""
# Tester Vercel Blob en développement : STORAGE_DRIVER="blob"
STORAGE_DRIVER=""

# Salle virtuelle (LiveKit Cloud : https://cloud.livekit.io → Settings → Keys).
# Vide = mode démo (chat, réactions, mains levées, présence ; vidéo limitée à sa propre caméra).
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Rate limiting distribué (optionnel — sinon stockage Postgres)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Google Calendar (optionnel)
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
